<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.haemin.spring.test.mvc.repository.SellerRepository">
 
 	<select id="selectLastSeller"
 	resultType="com.haemin.spring.test.mvc.domain.Seller">
 		SELECT
 			`id`
 			, `nickname`
 			, `temperature`
 			, `profileImage`
 			, `createdAt`
 			, `updatedAt`
 		FROM
 			`seller`
 		ORDER BY
 			`id` DESC
 		LIMIT
 			1
 	</select>
 
 </mapper>